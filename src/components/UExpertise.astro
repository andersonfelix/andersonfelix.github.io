---
import type { CollectionEntry } from "astro:content";

interface Props {
  expertise: CollectionEntry<"expertise">["data"];
}

const { title, description } = Astro.props.expertise;
---

<li>
  <h3>{title}</h3>
  <p>{description}</p>
</li>

<style>
  li {
    --_bg: transparent;
    --_outline: hsl(
      from var(--expertise-outline, var(--on-surface-variant)) h s l / 40%
    );
    --_outline-width: 0.1rem;
    --_title-color: hsl(from var(--primary) h s l / 90%);

    background-color: var(--_bg);
    border-left: var(--_outline-width) solid var(--_outline);
    padding: 0.5rem 0;
    position: relative;
    transition:
      background-color var(--transition),
      border var(--transition);

    @media (hover: hover) {
      &:hover {
        --_bg: hsl(from var(--secondary) h s l / 5%);
        --_outline: var(--expertise-outline-hover, var(--on-secondary));
        --_outline-width: 0.25rem;
        --_title-color: var(--secondary);
      }
    }

    @media (hover: none) {
      --_outline-width: 0;
      --_title-color: var(--secondary);

      border-bottom: 0.1rem solid var(--_outline);
      padding-bottom: 1.5rem;

      &:last-child {
        border-bottom-width: 0;
        padding-bottom: 0;
      }
    }

    @media (width > 450px) {
      padding-inline: 1rem;
    }
  }

  h3 {
    --heading-margin-end: 0.5rem;

    color: var(--_title-color);
    font-size: var(--text-lg);
    transition: color var(--transition);
  }

  p {
    font-family: var(--font-prose);
    line-height: 1.5;
    margin: 0;
  }
</style>
