---
interface Props {
  as?: "li" | "dd";
  variant?: "outline" | "soft";
  size?: "sm" | "md" | "lg";
}

const { as: Tag = "li", variant = "outline", size = "md" } = Astro.props;
---

<Tag class:list={["tag", variant, size]}>
  <slot />
</Tag>

<style>
  .tag {
    --_bg: hsl(from var(--primary) h s l / 10%);
    --_outline: var(--tag-outline, hsl(from var(--primary) h s l / 15%));
    --_color: var(--primary);
    --_shadow-offset: var(--shadow-offset-sm-hover);
    --_shadow-color: var(--shadow-hover);

    border-radius: var(--corner-extra-small);
    box-shadow: var(--_shadow-offset) var(--_shadow-color);
    margin: 0;
    padding: 0.3em 0.6em;
    transition:
      background-color var(--transition),
      border-color var(--transition),
      box-shadow var(--transition);

    @media (hover: hover) {
      &:hover {
        --_bg: hsl(from var(--tag-color-hover, var(--primary)) h s l / 20%);
        --_outline: var(
          --tag-outline-hover,
          hsl(from var(--primary) h s l / 60%)
        );
        --_color: var(--tag-color-hover, var(--primary));
        --_shadow-offset: var(--shadow-offset-sm);
        --_shadow-color: var(--shadow);
      }
    }
  }

  .outline {
    border: var(--outline-width-sm) solid var(--_outline);
  }

  .soft {
    background-color: var(--_bg);
    color: var(--_color);
  }

  .sm {
    font-size: var(--text-sm);
  }

  .md {
    font-size: var(--text-md);
  }

  .lg {
    font-size: var(--text-lg);
  }
</style>
