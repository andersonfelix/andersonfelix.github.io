---
interface Props {
  as?: "li" | "dd";
  variant?: "outline" | "soft";
  size?: "sm" | "md" | "lg";
}

const { as: Tag = "li", variant = "outline", size = "md" } = Astro.props;
---

<Tag class:list={["tag", variant, size]}>
  <slot />
</Tag>

<style>
  .tag {
    --bg-color: hsl(from var(--primary) h s l / 10%);
    --border-color: hsl(from var(--primary) h s l / 15%);

    border-radius: 0.25rem;
    margin: 0;
    padding: 0.3em 0.6em;
    transition:
      background-color var(--transition-ease-in),
      border-color var(--transition-ease-in);

    @media (hover: hover) {
      &:hover {
        --bg-color: hsl(from var(--primary) h s l / 20%);
        --border-color: hsl(from var(--primary) h s l / 60%);
      }
    }
  }

  .outline {
    border: 0.05rem solid var(--border-color);
  }

  .soft {
    background-color: var(--bg-color);
    color: var(--primary);
  }

  .sm {
    font-size: var(--text-sm);
  }

  .md {
    font-size: var(--text-md);
  }

  .lg {
    font-size: var(--text-lg);
  }
</style>
