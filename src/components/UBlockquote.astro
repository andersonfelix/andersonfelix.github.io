---
import UCite from "@components/UCite.astro";
import { Icon } from "astro-icon/components";
---

<blockquote>
  <p>
    <Icon name="mdi:format-quote-open" aria-hidden="true" />
    <slot name="text" />
    <Icon name="mdi:format-quote-close" aria-hidden="true" />
  </p>

  {Astro.slots.has("author") && (
    <footer>
      —
      <UCite>
        <span>
          <strong>
            <slot name="author" />
          </strong>
          <slot name="origin" />
        </span>
      </UCite>
    </footer>
  )}
</blockquote>

<style>
  blockquote {
    --_accent: var(--primary);
    --_line-color: hsl(from var(--primary) h s l / 10%);
    --_angle: 0;

    margin-left: 0;
    margin-block: 2.5rem;
    padding: 1rem;
    position: relative;
    transition: border-left-color var(--transition);
    width: 100%;

    @media (width >= 1024px) {
      margin-block: 5rem;
      padding-inline: 3rem;

      &::before,
      &::after {
        background: var(--_line-color);
        content: "";
        height: 100%;
        inset: 0;
        position: absolute;
        width: var(--blockquote-line-width, 0.1rem);
        transform: rotate(var(--_angle));
        transition:
          background var(--transition),
          transform var(--transition);
      }

      &::after {
        inset: 0 0 auto auto;
      }
    }

    p {
      align-items: center;
      column-gap: 0.5rem;
      display: flex;
      font-family: var(--font-prose);
      font-size: clamp(1.1rem, -1rem + 9vw, 1.4rem);
      justify-content: center;
      margin-bottom: 1rem;
      margin-top: 0;

      [data-icon] {
        color: var(--_accent);
        display: none;
        font-size: 2rem;

        @media (width >= 1024px) {
          display: inline;
        }
      }
    }

    footer {
      color: var(--_accent);
      display: flex;
      column-gap: 0.5rem;
      justify-content: center;
      transition: color var(--transition);
    }

    @media (hover: hover) {
      &:hover {
        --_accent: var(--secondary);
        --_line-color: hsl(from var(--secondary) h s l / 30%);
        --_angle: 15deg;
        --cite-color: var(--secondary);
      }
    }
  }
</style>
