---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import UStatus from "@components/UStatus.astro";
import photo from "../assets/me.png";

const { name, role, tagline, availability } = (await getEntry(
  "profile",
  "main",
))!.data;
---

<header>
  <Image
    src={photo}
    alt={`Foto de ${name}`}
    width={160}
    height={160}
    densities={[1, 2]}
    loading="eager"
  />
  <div>
    <h1>{name}</h1>
    <p class="role">{role}</p>
    <p class="tagline">{tagline}</p>
    <UStatus variant="pulse">{availability}</UStatus>
  </div>
</header>

<style>
  header {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    place-items: center;
    text-align: center;

    @media (width >= 768px) {
      gap: 2.5rem;
      grid-template-columns: auto 1fr;
      place-items: center start;
      text-align: start;
    }
  }

  img {
    border-radius: 0.75rem;
    height: auto;
    max-width: 160px;
  }

  h1 {
    color: var(--primary);
    margin-block: 0;
  }

  p {
    margin-block: 0.75rem 0;
  }

  .role {
    color: var(--secondary);
  }

  .tagline {
    color: var(--on-surface);
    font-family: var(--font-paragraph);
    font-size: var(--text-lg);
    line-height: 1.4;
    margin-inline: auto;
    max-width: 40rem;

    @media (width >= 768px) {
      margin-inline: 0;
    }
  }
</style>
