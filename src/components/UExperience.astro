---
import type { CollectionEntry } from "astro:content";

interface Props {
  experience: CollectionEntry<"experience">["data"];
}

const { organization, role, period } = Astro.props.experience;
---

<li>
  <span class="period">{period}</span>
  <strong>{organization}</strong>
  <span class="role">{role}</span>
</li>

<style>
  li {
    background-color: var(--bg-color, transparent);
    border: 0.1rem dashed var(--border-color, transparent);
    border-radius: 1rem;
    display: grid;
    gap: 0.3rem;
    padding: 1.5rem 1rem;
    margin-left: 0.5rem;
    position: relative;
    transition:
      background-color var(--transition-ease-in),
      border-color var(--transition-ease-in);

    &::before,
    &::after {
      border-radius: 50%;
      content: "";
      position: absolute;
      transition: background-color var(--transition-ease-in);
    }

    &::before {
      background-color: var(--before-bg-color, var(--primary));
      height: 0.8rem;
      left: calc(-1.5rem - 0.5rem - 0.5px);
      outline: 0.1rem dashed var(--before-outline-color, var(--surface-variant));
      outline-offset: 0.5rem;
      top: 1.5rem;
      width: 0.8rem;
      z-index: 2;
    }

    &::after {
      background-color: var(--after-bg-color, var(--surface));
      height: 1.6rem;
      left: calc(-1.5rem - 0.9rem - 0.5px);
      top: 1.1rem;
      width: 1.6rem;
    }

    &:last-child {
      margin-bottom: 0;
    }

    @media (hover: hover) {
      &:hover {
        --bg-color: hsl(from var(--secondary) h s l / 5%);
        --border-color: hsl(from var(--secondary) h s l / 40%);
        --before-bg-color: var(--secondary);
      }

      &:hover ~ li {
        --before-bg-color: var(--surface-variant);
      }
    }
  }

  .period {
    color: var(--secondary);
    font-size: var(--text-xs);
  }

  strong {
    color: var(--on-surface);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .role {
    color: var(--on-surface-variant);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
</style>
