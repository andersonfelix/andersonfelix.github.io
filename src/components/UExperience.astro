---
import type { CollectionEntry } from "astro:content";

interface Props {
  experience: CollectionEntry<"experience">["data"];
}

const { organization, role, period } = Astro.props.experience;
---

<li>
  <span class="period">{period}</span>
  <strong>{organization}</strong>
  <span class="role">{role}</span>
</li>

<style>
  li {
    --_bg: transparent;
    --_outline: transparent;
    --_dot-color: var(--primary);

    background-color: var(--_bg);
    border: 0.1rem dashed var(--_outline);
    border-radius: var(--corner-extra-large);
    display: grid;
    gap: 0.3rem;
    padding: 1.5rem 1rem;
    margin-left: 0.5rem;
    position: relative;
    transition:
      background-color var(--transition),
      border-color var(--transition);

    &::before,
    &::after {
      border-radius: var(--experience-dot-corner, 50%);
      content: "";
      height: var(--_size);
      left: calc(-1.6rem - 0.5px - var(--_size) / 2);
      position: absolute;
      rotate: var(--experience-dot-rotate, none);
      top: calc(1.9rem - var(--_size) / 2);
      transition: background-color var(--transition);
      width: var(--_size);
    }

    &::before {
      --_size: var(--experience-dot-size, 0.8rem);

      background-color: var(--_dot-color);
      outline: 0.1rem dashed var(--surface-variant);
      outline-offset: var(--experience-dot-ring-offset, 0.5rem);
      z-index: 2;
    }

    &::after {
      --_size: calc(2 * var(--experience-dot-size, 0.8rem));

      background-color: var(--surface);
    }

    &:last-child {
      margin-bottom: 0;
    }

    @media (hover: hover) {
      &:hover {
        --_bg: hsl(from var(--secondary) h s l / 5%);
        --_outline: hsl(from var(--secondary) h s l / 40%);
        --_dot-color: var(--secondary);
      }

      &:hover ~ li {
        --_dot-color: var(--surface-variant);
      }
    }
  }

  .period {
    color: var(--secondary);
    font-size: var(--text-xs);
  }

  strong {
    color: var(--on-surface);
    font-family: var(--font-heading);
    font-size: var(--text-lg);
  }

  .role {
    color: var(--on-surface-variant);
    font-size: var(--text-sm);
    line-height: 1.5;
  }
</style>
