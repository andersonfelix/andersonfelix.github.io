---
import { Icon } from "astro-icon/components";

const modes = [
  { mode: "auto", label: "sistema", icon: "mdi:theme-light-dark" },
  { mode: "light", label: "claro", icon: "mdi:weather-sunny" },
  { mode: "dark", label: "escuro", icon: "mdi:weather-night" },
  { mode: "neobrutalism", label: "neobrutalista", icon: "mdi:cube-outline" },
];
---

<button type="button" class="theme-toggle" data-theme-toggle hidden>
  {modes.map(({ mode, label, icon }) => (
    <span data-mode={mode} data-label={label}>
      <Icon name={icon} aria-hidden="true" />
    </span>
  ))}
</button>

{/* prettier-ignore */}
<script>
  type Mode = "auto" | "light" | "dark" | "neobrutalism";

  const KEY = "theme";
  const order: Mode[] = ["auto", "light", "dark", "neobrutalism"];
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]",
  )!;
  const metas = document.querySelectorAll<HTMLMetaElement>(
    'meta[name="theme-color"]',
  );

  const current = (): Mode => (root.dataset.theme as Mode) ?? "auto";

  const apply = (mode: Mode) => {
    if (mode === "auto") delete root.dataset.theme;
    else root.dataset.theme = mode;

    try {
      if (mode === "auto") localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, mode);
    } catch {
      // Storage unavailable
    }

    const surface = getComputedStyle(root).getPropertyValue("--surface");
    metas.forEach((meta) => {
      meta.dataset.auto ??= meta.content;
      meta.content = mode === "auto" ? meta.dataset.auto : surface.trim();
    });

    button.dataset.current = mode;
    const label = button.querySelector<HTMLElement>(`[data-mode="${mode}"]`)!
      .dataset.label;
    button.setAttribute("aria-label", `Alternar tema (atual: ${label})`);
    button.title = `Tema: ${label}`;
  };

  button.addEventListener("click", () => {
    apply(order[(order.indexOf(current()) + 1) % order.length]);
  });

  apply(current());
  button.hidden = false;
</script>

<style>
  .theme-toggle {
    --_outline: transparent;

    align-items: center;
    background: transparent;
    border: var(--link-outline-width) solid var(--_outline);
    border-radius: var(--corner-small);
    color: var(--link);
    cursor: pointer;
    display: inline-flex;
    font-size: var(--text-lg);
    padding: 0.25rem 0.5rem;
    transition:
      background-color var(--transition),
      border-color var(--transition);

    @media (any-pointer: coarse) {
      justify-content: center;
      min-block-size: 2.2rem;
      min-inline-size: 2.2rem;
    }

    &[hidden] {
      display: none;
    }

    &:focus-visible {
      --_outline: var(--link-outline);

      background-color: var(--link-container);
      outline: 0.1rem solid var(--focus-ring);
      outline-offset: 0.1rem;
    }

    @media (hover: hover) {
      &:hover {
        --_outline: var(--link-outline);

        background-color: var(--link-container);
      }
    }
  }

  span {
    display: none;
  }

  .theme-toggle[data-current="auto"] [data-mode="auto"],
  .theme-toggle[data-current="light"] [data-mode="light"],
  .theme-toggle[data-current="dark"] [data-mode="dark"],
  .theme-toggle[data-current="neobrutalism"] [data-mode="neobrutalism"] {
    display: inline-flex;
  }
</style>
