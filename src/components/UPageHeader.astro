---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<header>
  <h1>{title}</h1>
  {subtitle && <p>{subtitle}</p>}
</header>

<style>
  header {
    margin-bottom: 2.5rem;
  }

  h1 {
    color: var(--primary);
    margin-block: 0;
  }

  p {
    color: var(--secondary);
    margin-block: 0.5rem 0;
  }
</style>
