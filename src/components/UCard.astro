---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  as?: "div" | "article";
};

const { as: Tag = "div", class: className, ...rest } = Astro.props;
---

<Tag class:list={["c-card", className]} {...rest}>
  <slot />
</Tag>

<style>
  @property --c-card-edge {
    syntax: "<color>";
    initial-value: transparent;
    inherits: false;
  }

  @property --c-card-center {
    syntax: "<color>";
    initial-value: transparent;
    inherits: false;
  }

  .c-card {
    --c-card-edge: var(--card-bg-edge);
    --c-card-center: var(--card-bg-center);

    background: hsl(from var(--c-card-edge) h s l / 85%);
    background: linear-gradient(
      145deg,
      var(--c-card-edge) 0,
      var(--c-card-edge) 20%,
      var(--c-card-center) 30%,
      var(--c-card-center) 50%,
      var(--c-card-center) 70%,
      var(--c-card-edge) 80%,
      var(--c-card-edge) 100%
    );
    border: 0.05rem solid
      var(--border-color, hsl(from var(--primary) h s l / 5%));
    border-radius: var(--border-radius, 0.3rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    transition:
      --c-card-edge var(--transition-ease-in),
      --c-card-center var(--transition-ease-in),
      border-color var(--transition-ease-in),
      border-radius var(--transition-ease-in);

    @media (hover: hover) {
      &:hover {
        --border-color: hsl(from var(--primary) h s l / 10%);
        --c-card-edge: var(--card-bg-edge-hover);
        --c-card-center: var(--card-bg-center-hover);
        --border-radius: 0 1rem;

        @media (width >= 1024px) {
          --border-radius: 0 2rem;
        }
      }
    }

    @media (width >= 768px) {
      padding: 1.25rem;
    }
  }
</style>
