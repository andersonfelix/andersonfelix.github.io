---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  as?: "div" | "article";
};

const { as: Tag = "div", class: className, ...rest } = Astro.props;
---

<Tag class:list={["c-card", className]} {...rest}>
  <slot />
</Tag>

<style>
  @property --_edge {
    syntax: "<color>";
    initial-value: transparent;
    inherits: false;
  }

  @property --_center {
    syntax: "<color>";
    initial-value: transparent;
    inherits: false;
  }

  .c-card {
    --_edge: var(--card-gradient-edge);
    --_center: var(--card-gradient-center);
    --_outline: var(--card-outline, var(--outline));
    --_radius: var(--corner-small);
    --_shadow-offset: var(--shadow-offset);
    --_shadow-color: var(--card-shadow, var(--shadow));

    background: hsl(from var(--_edge) h s l / 85%);
    background: linear-gradient(
      145deg,
      var(--_edge) 0,
      var(--_edge) 20%,
      var(--_center) 30%,
      var(--_center) 50%,
      var(--_center) 70%,
      var(--_edge) 80%,
      var(--_edge) 100%
    );
    border: var(--outline-width) solid var(--_outline);
    border-radius: var(--_radius);
    box-shadow: var(--_shadow-offset) var(--_shadow-color);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1rem;
    transition:
      --_edge var(--transition),
      --_center var(--transition),
      border-color var(--transition),
      border-radius var(--transition),
      box-shadow var(--transition),
      translate var(--transition);

    @media (hover: hover) {
      &:hover {
        --_edge: var(--card-gradient-edge-hover);
        --_center: var(--card-gradient-center-hover);
        --_outline: var(--card-outline-hover, var(--outline-hover));
        --_radius: 0 var(--corner-extra-large);
        --_shadow-offset: var(--shadow-offset-hover);
        --_shadow-color: var(--card-shadow-hover, var(--shadow-hover));

        translate: var(--lift);

        @media (width >= 1024px) {
          --_radius: 0 calc(2 * var(--corner-extra-large));
        }
      }
    }

    @media (width >= 768px) {
      padding: 1.25rem;
    }
  }
</style>
