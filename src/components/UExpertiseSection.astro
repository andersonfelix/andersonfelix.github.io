---
import UExpertise from "@components/UExpertise.astro";
import USection from "@components/USection.astro";
import USkills from "@components/USkills.astro";
import { getOrderedCollection } from "../utils/content";

const expertise = await getOrderedCollection("expertise");
---

<USection id="especialidades" title="Especialidades">
  <ul>
    {expertise.map(({ data }) => (
      <UExpertise expertise={data} />
    ))}
  </ul>
  <USkills />
</USection>

<style>
  ul {
    display: grid;
    gap: 1.5rem 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 30rem), 1fr));
    list-style: none;
    padding: 0;
  }
</style>
